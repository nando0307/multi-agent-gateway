# --- routed providers (N=4; Azure OpenAI dropped, see PLAN.md D6) -----------------
# A provider with no key is simply absent from the router -- N is computed, not asserted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3.1-flash-lite
NVIDIA_NIM_API_KEY=
NIM_MODEL=nvidia_nim/nvidia/llama-3.3-nemotron-super-49b-v1
OPENROUTER_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Local terminal tier. No key: it is free and cannot rate-limit, which is why the chain
# ends here. Requires `ollama serve` and `ollama pull qwen3.5:4b`.
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=ollama_chat/qwen3.5:4b

# Pick an upstream vendor distinct from Gemini/NIM so the tiers fail independently.
# Verify the slug at https://openrouter.ai/models before relying on it.
OPENROUTER_MODEL=openrouter/mistralai/mistral-small-3.2-24b-instruct

# --- tools -------------------------------------------------------------------------
TAVILY_API_KEY=

# --- eval judge --------------------------------------------------------------------
# MUST NOT be the same MODEL as any routed one -- settings.py asserts this. A different
# model on a shared account is allowed but weaker, and gets flagged in the matrix report.
# Leave the key blank for an openrouter/ judge: it reuses OPENROUTER_API_KEY.
JUDGE_API_KEY=
JUDGE_MODEL=openrouter/openai/gpt-oss-120b
