# Approved generation order: Gemini -> OpenRouter -> Groq -> direct DeepSeek.
# Missing keys disable that provider. Secrets stay on the gateway server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3.1-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/mistralai/mistral-small-3.2-24b-instruct
GROQ_API_KEY=
GROQ_MODEL=groq/openai/gpt-oss-120b
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-chat

# Internal Boss generation service. Generate a separate random service secret.
GATEWAY_SERVICE_TOKEN=
GENERATION_DEADLINE_S=60
# Above gemini's measured p95 of ~23 s (results/latency.md), so tail latency on a
# healthy primary completes instead of turning into a silent retry ladder.
GENERATION_ATTEMPT_S=30
# Provider timeouts also cap each attempt; the total deadline always wins. Keep them
# at or above GENERATION_ATTEMPT_S or they become the real attempt cap.
GEMINI_TIMEOUT_S=45
OPENROUTER_TIMEOUT_S=45
GROQ_TIMEOUT_S=45
DEEPSEEK_TIMEOUT_S=45

# --- tools -------------------------------------------------------------------------
TAVILY_API_KEY=
# Fallback when Tavily's quota is exhausted (free plan hard-caps at 1000/month, no
# pay-as-you-go overflow). Sign up at platform.parallel.ai.
PARALLEL_API_KEY=

# --- eval judge --------------------------------------------------------------------
# MUST NOT be the same MODEL as any routed one -- settings.py asserts this. A different
# model on a shared account is allowed but weaker, and gets flagged in the matrix report.
# Configure the optional research judge separately; never use a serving model as judge.
JUDGE_API_KEY=
JUDGE_MODEL=claude-sonnet-5
